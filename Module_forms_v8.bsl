// АВТОМАТИЧЕСКАЯ РАССТАНОВКА КЛЮЧЕЙ В ТАБЛИЧНОЙ ЧАСТИ

// Заполняет пустые ячейки колонки «Ключ» таблицы ТЧ значением выбранного ключа шапки:
//  1) строка к строке, если строк в шапке и в ТЧ поровну (ключ в шапке повторяется для каждой строки ТЧ);
//  2) иначе — продолжением ключа предыдущей строки;
//  3) если в шапке один объект — его ключом для всех строк.
&НаСервере
Функция ПроставитьКлючиТЧ()

    Если Не Объект.Импорт_ЕстьТабличнаяЧасть Или ПустаяСтрока(Объект.Импорт_КлючевоеПолеТЧ) Тогда
        Возврат 0;
    КонецЕсли;

    МД = ОбъектМетаданных();
    Если МД = Неопределено Тогда
        Возврат 0;
    КонецЕсли;
    МДТЧ = МД.ТабличныеЧасти.Найти(Объект.Импорт_ИмяТабличнойЧастиДокумента);
    Если МДТЧ = Неопределено Тогда
        Возврат 0;
    КонецЕсли;

    ИмяКлюча = ?(ПустаяСтрока(Объект.Импорт_КлючевоеПолеШапки),
        ИмяКлючаПоУмолчанию(), Объект.Импорт_КлючевоеПолеШапки);
    ИмяКлючаТЧ = Объект.Импорт_КлючевоеПолеТЧ;

    Шапка = Объект.Импорт_ТабличныйДокумент;
    ТЧ = Объект.Импорт_ТабличныйДокументТЧ;

    КолонкаШапки = ЗаголовкиШапкиТаблицы(МД).Получить(ИмяКлюча);
    Если КолонкаШапки = Неопределено Или ТЧ.ВысотаТаблицы < 2 Тогда
        Возврат 0;
    КонецЕсли;

    КолонкаТЧ = ЗаголовкиТаблицыТЧ(МДТЧ).Получить(ИмяКлючаТЧ);
    Если КолонкаТЧ = Неопределено Тогда
        КолонкаТЧ = ТЧ.ШиринаТаблицы + 1;
        ТЧ.Область("R1C" + Формат(КолонкаТЧ, "ЧГ=")).Текст = ИмяКлючаТЧ;
    КонецЕсли;

    НомераШапки = НомераНепустыхСтрок(Шапка, Макс(2, Объект.Импорт_ПерваяСтрокаДанных));
    НомераТЧ = НомераНепустыхСтрок(ТЧ, 2);
    Парно = (НомераШапки.Количество() = НомераТЧ.Количество());

    // Единственный ключ шапки (если все строки шапки — один объект)
    ЕдинственныйКлюч = "";
    УникальныеКлючи = Новый Соответствие;
    Для Каждого НомерСтроки Из НомераШапки Цикл
        Текст = СокрЛП(Шапка.Область("R" + Формат(НомерСтроки, "ЧГ=") + "C" + Формат(КолонкаШапки, "ЧГ=")).Текст);
        Если Не ПустаяСтрока(Текст) Тогда
            УникальныеКлючи.Вставить(КлючДляСопоставления(Текст), Текст);
        КонецЕсли;
    КонецЦикла;
    Если УникальныеКлючи.Количество() = 1 Тогда
        Для Каждого КлючИЗначение Из УникальныеКлючи Цикл
            ЕдинственныйКлюч = КлючИЗначение.Значение;
        КонецЦикла;
    КонецЕсли;

    Заполнено = 0;
    Предыдущий = "";

    Для н = 0 По НомераТЧ.Количество() - 1 Цикл

        АдресТЧ = "R" + Формат(НомераТЧ[н], "ЧГ=") + "C" + Формат(КолонкаТЧ, "ЧГ=");
        Текст = СокрЛП(ТЧ.Область(АдресТЧ).Текст);

        Если Не ПустаяСтрока(Текст) Тогда
            Предыдущий = Текст;
            Продолжить;
        КонецЕсли;

        НовыйКлюч = "";
        Если Парно Тогда
            НовыйКлюч = СокрЛП(Шапка.Область("R" + Формат(НомераШапки[н], "ЧГ=")
                + "C" + Формат(КолонкаШапки, "ЧГ=")).Текст);
        КонецЕсли;
        Если ПустаяСтрока(НовыйКлюч) Тогда
            НовыйКлюч = Предыдущий;
        КонецЕсли;
        Если ПустаяСтрока(НовыйКлюч) Тогда
            НовыйКлюч = ЕдинственныйКлюч;
        КонецЕсли;

        Если Не ПустаяСтрока(НовыйКлюч) Тогда
            ТЧ.Область(АдресТЧ).Текст = НовыйКлюч;
            Предыдущий = НовыйКлюч;
            Заполнено = Заполнено + 1;
        КонецЕсли;

    КонецЦикла;

    Возврат Заполнено;

КонецФункции

&НаСервереБезКонтекста
Функция НомераНепустыхСтрок(ТабДок, НачальнаяСтрока)

    Номера = Новый Массив;
    Для К = НачальнаяСтрока По ТабДок.ВысотаТаблицы Цикл
        Если Не СтрокаТабличногоДокументаПустая(ТабДок, К) Тогда
            Номера.Добавить(К);
        КонецЕсли;
    КонецЦикла;
    Возврат Номера;

КонецФункции

// Строки шапки с одинаковым ключом сливаются в одну (непустые значения более поздних строк дополняют/заменяют)
&НаСервереБезКонтекста
Функция ОбъединитьСтрокиШапки(СтрокиШапки, ИмяКлюча)

    Результат = Новый Массив;
    Индекс = Новый Соответствие;
    Объединено = 0;

    Для Каждого СтрокаДанных Из СтрокиШапки Цикл

        ТекстКлюча = СтрокаДанных.Получить(ИмяКлюча);
        Если ТекстКлюча = Неопределено Или ПустаяСтрока(ТекстКлюча) Тогда
            Результат.Добавить(СтрокаДанных);
            Продолжить;
        КонецЕсли;

        Сопоставимый = КлючДляСопоставления(ТекстКлюча);
        Существующая = Индекс[Сопоставимый];

        Если Существующая = Неопределено Тогда
            Индекс.Вставить(Сопоставимый, СтрокаДанных);
            Результат.Добавить(СтрокаДанных);
        Иначе
            Для Каждого КлючИЗначение Из СтрокаДанных Цикл
                Если Не ПустаяСтрока(КлючИЗначение.Значение) Тогда
                    Существующая.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
                КонецЕсли;
            КонецЦикла;
            Объединено = Объединено + 1;
        КонецЕсли;

    КонецЦикла;

    Возврат Новый Структура("Строки, Объединено", Результат, Объединено);

КонецФункции

&НаСервере
Процедура ЗаполнитьСписокКлючейТЧ()

    Список = Элементы.Импорт_КлючевоеПолеТЧ.СписокВыбора;
    Список.Очистить();

    МД = ОбъектМетаданных();
    Если МД = Неопределено Или ПустаяСтрока(Объект.Импорт_ИмяТабличнойЧастиДокумента) Тогда
        Объект.Импорт_КлючевоеПолеТЧ = "";
        Возврат;
    КонецЕсли;

    МДТЧ = МД.ТабличныеЧасти.Найти(Объект.Импорт_ИмяТабличнойЧастиДокумента);
    Если МДТЧ = Неопределено Тогда
        Объект.Импорт_КлючевоеПолеТЧ = "";
        Возврат;
    КонецЕсли;

    Для Каждого Реквизит Из МДТЧ.Реквизиты Цикл
        Список.Добавить(Реквизит.Имя, Реквизит.Синоним);
    КонецЦикла;

    // Выбранное ранее поле должно существовать в этой табличной части
    Если Не ПустаяСтрока(Объект.Импорт_КлючевоеПолеТЧ) И МДТЧ.Реквизиты.Найти(Объект.Импорт_КлючевоеПолеТЧ) = Неопределено Тогда
        Объект.Импорт_КлючевоеПолеТЧ = "";
    КонецЕсли;

    // Подбираем поле автоматически: в его названии есть название ключа шапки («Номер» -> «Номер заказа»)
    Если ПустаяСтрока(Объект.Импорт_КлючевоеПолеТЧ) Тогда
        КлючШапки = НРег(?(ПустаяСтрока(Объект.Импорт_КлючевоеПолеШапки),
            ИмяКлючаПоУмолчанию(), Объект.Импорт_КлючевоеПолеШапки));
        Для Каждого Реквизит Из МДТЧ.Реквизиты Цикл
            Если Найти(НРег(Реквизит.Имя), КлючШапки) > 0 Или Найти(НРег(Реквизит.Синоним), КлючШапки) > 0 Тогда
                Объект.Импорт_КлючевоеПолеТЧ = Реквизит.Имя;
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииТЧНаСервере()

    Объект.Импорт_КлючевоеПолеТЧ = "";
    ЗаполнитьЗаголовкиТЧ();

КонецПроцедуры

&НаСервереБезКонтекста
Функция НормализоватьЗаголовок(Знач Текст)

    Текст = НРег(СокрЛП(Текст));
    Текст = СтрЗаменить(Текст, "ё", "е");
    Текст = СтрЗаменить(Текст, " ", "");
    Текст = СтрЗаменить(Текст, "_", "");
    Текст = СтрЗаменить(Текст, ".", "");
    Текст = СтрЗаменить(Текст, "-", "");
    Текст = СтрЗаменить(Текст, Символы.НПП, "");
    Текст = СтрЗаменить(Текст, Символы.ПС, "");
    Текст = СтрЗаменить(Текст, Символы.Таб, "");
    Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьСловарьКолонок(Стандартные, КоллекцияРеквизитов)

    Словарь = Новый Соответствие;
    Для Каждого Имя Из Стандартные Цикл
        Словарь.Вставить(НормализоватьЗаголовок(Имя), Имя);
    КонецЦикла;
    Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
        Словарь.Вставить(НормализоватьЗаголовок(Реквизит.Синоним), Реквизит.Имя);
        Словарь.Вставить(НормализоватьЗаголовок(Реквизит.Имя), Реквизит.Имя);
    КонецЦикла;
    Возврат Словарь;

КонецФункции

&НаСервереБезКонтекста
Функция ПсевдонимСтандартнойКолонки(Норм, Режим)

    Если Режим = "Документ" Тогда
        Если Лев(Норм, 5) = "номер" Тогда
            Возврат "Номер";
        КонецЕсли;
    ИначеЕсли Режим = "Справочник" Тогда
        Если Лев(Норм, 3) = "код" Тогда
            Возврат "Код";
        ИначеЕсли Лев(Норм, 8) = "наименов" Или Лев(Норм, 8) = "название" Тогда
            Возврат "Наименование";
        КонецЕсли;
    КонецЕсли;
    Возврат Неопределено;

КонецФункции

