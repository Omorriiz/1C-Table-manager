&НаКлиенте
Процедура КомандаЗагрузитьКартинки(Команда)

    ОчиститьСообщения();

    Если ПустаяСтрока(Объект.Импорт_ТипОбъектаДокумента) Тогда
        ПоказатьОшибку("Сначала выберите справочник (шаг 1).", "Объект.Импорт_ТипОбъектаДокумента");
        Возврат;
    КонецЕсли;

    Если Элементы.КартинкиРеквизит.СписокВыбора.Количество() = 0 Тогда
        ПоказатьОшибку("В справочнике «" + Объект.Импорт_ТипОбъектаДокумента + "» нет реквизита для картинки. "
            + "Нужен реквизит типа «Хранилище значения» или «Двоичные данные» — добавьте его в конфигураторе.");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(ЭтаФорма.КартинкиРеквизит) Тогда
        ПоказатьОшибку("Выберите реквизит, в который записывать картинку.", "КартинкиРеквизит");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(ЭтаФорма.КартинкиПапка) Тогда
        ПоказатьОшибку("Выберите папку с картинками (кнопка справа в поле).", "КартинкиПапка");
        Возврат;
    КонецЕсли;

    Если Не ПустаяСтрока(ЭтаФорма.КартинкиПоУмолчанию) Тогда
        ФайлПоУмолчанию = Новый Файл(ЭтаФорма.КартинкиПоУмолчанию);
        Расширение = НРег(ФайлПоУмолчанию.Расширение);
        Если Расширение <> ".jpg" И Расширение <> ".jpeg" И Расширение <> ".png"
            И Расширение <> ".bmp" И Расширение <> ".gif" Тогда
            ПоказатьОшибку("Картинка по умолчанию должна быть файлом jpg, jpeg, png, bmp или gif.",
                "КартинкиПоУмолчанию");
            Возврат;
        КонецЕсли;
    КонецЕсли;

    ФайлПапки = Новый Файл(ЭтаФорма.КартинкиПапка);
    ФайлПапки.НачатьПроверкуСуществования(
        Новый ОписаниеОповещения("КартинкиПослеПроверкиПапки", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура КартинкиПослеПоиска(НайденныеФайлы, ДополнительныеПараметры) Экспорт

    Описания = Новый Массив;
    Для Каждого Файл Из НайденныеФайлы Цикл
        Расширение = НРег(Файл.Расширение);
        Если Файл.ПолноеИмя = ЭтаФорма.КартинкиПоУмолчанию Тогда
            Продолжить; // файл по умолчанию — не картинка конкретного элемента
        КонецЕсли;
        Если Расширение = ".jpg" Или Расширение = ".jpeg" Или Расширение = ".png"
            Или Расширение = ".bmp" Или Расширение = ".gif" Тогда
            Описания.Добавить(Новый ОписаниеПередаваемогоФайла(Файл.ПолноеИмя));
        КонецЕсли;
    КонецЦикла;

    КоличествоФайлов = Описания.Количество();

    Если КоличествоФайлов = 0 И ПустаяСтрока(ЭтаФорма.КартинкиПоУмолчанию) Тогда
        ПоказатьОшибку("В папке «" + ЭтаФорма.КартинкиПапка + "» нет картинок (jpg, jpeg, png, bmp, gif). "
            + "Проверьте, что выбрана нужная папка.", "КартинкиПапка");
        Возврат;
    КонецЕсли;

    Если Не ПустаяСтрока(ЭтаФорма.КартинкиПоУмолчанию) Тогда
        Описания.Добавить(Новый ОписаниеПередаваемогоФайла(ЭтаФорма.КартинкиПоУмолчанию));
    КонецЕсли;

    Текст = "Картинок в папке: " + КоличествоФайлов + Символы.ПС
        + "Искать элемент по: " + ЭтаФорма.КартинкиКлюч + " (из имени файла)" + Символы.ПС
        + "Записывать в реквизит: " + ЭтаФорма.КартинкиРеквизит + Символы.ПС + Символы.ПС;
    Если ЭтаФорма.КартинкиЗаменять Тогда
        Текст = Текст + "Внимание: уже загруженные картинки будут ЗАМЕНЕНЫ." + Символы.ПС;
    Иначе
        Текст = Текст + "Элементы, у которых картинка уже есть, пропускаются." + Символы.ПС;
    КонецЕсли;
    Если Не ПустаяСтрока(ЭтаФорма.КартинкиПоУмолчанию) Тогда
        ФайлПоУмолчанию = Новый Файл(ЭтаФорма.КартинкиПоУмолчанию);
        Текст = Текст + "Элементам без картинки будет подставлена: " + ФайлПоУмолчанию.Имя + Символы.ПС;
    КонецЕсли;
    Текст = Текст + Символы.ПС + "Продолжить?";

    ПоказатьВопрос(Новый ОписаниеОповещения("КартинкиПослеПодтверждения", ЭтотОбъект, Описания),
        Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Загрузка картинок");

КонецПроцедуры

&НаКлиенте
Процедура КартинкиПослеПомещения(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

    Если ПомещенныеФайлы = Неопределено Тогда
        ПоказатьПредупреждение(, "Файлы не были переданы на сервер. Попробуйте ещё раз.");
        Возврат;
    КонецЕсли;

    ОчиститьСообщения();

    Файлы = Новый Массив;
    АдресПоУмолчанию = "";
    Для Каждого Файл Из ПомещенныеФайлы Цикл
        Если Не ЗначениеЗаполнено(Файл.Хранение) Тогда
            Продолжить;
        КонецЕсли;
        Если Файл.ПолноеИмя = ЭтаФорма.КартинкиПоУмолчанию Тогда
            АдресПоУмолчанию = Файл.Хранение;
        Иначе
            Файлы.Добавить(Новый Структура("Имя, Адрес", Файл.Имя, Файл.Хранение));
        КонецЕсли;
    КонецЦикла;

    Попытка
        Итог = ЗагрузитьКартинкиНаСервере(Файлы, АдресПоУмолчанию);
    Исключение
        ПоказатьПредупреждение(, "Загрузка картинок прервана из-за ошибки: "
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат;
    КонецПопытки;

    ПоказатьОповещениеПользователя("Картинки загружены", ,
        "Загружено: " + Итог.Загружено + ", по умолчанию: " + Итог.ПоУмолчанию
        + ", пропущено: " + Итог.Пропущено + ", не найдено элементов: " + Итог.НеНайдено);

    Если Итог.НеНайдено > 0 Тогда
        ПоказатьПредупреждение(, "Для " + Итог.НеНайдено + " файлов не нашлось элементов справочника. "
            + "Список — в окне сообщений. Проверьте, что номера в именах файлов совпадают со значением поля «"
            + ЭтаФорма.КартинкиКлюч + "».");
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьКартинкиНаСервере(Файлы, АдресПоУмолчанию)

    Итог = Новый Структура("Загружено, Пропущено, НеНайдено, ПоУмолчанию", 0, 0, 0, 0);

    МД = ОбъектМетаданных();
    Если МД = Неопределено Или ЭтаФорма.РежимИмпорта <> "Справочник" Тогда
        Возврат Итог;
    КонецЕсли;

    ИмяРекв = ЭтаФорма.КартинкиРеквизит;
    ИмяКлюча = ?(ПустаяСтрока(ЭтаФорма.КартинкиКлюч), "Код", ЭтаФорма.КартинкиКлюч);

    РеквизитМД = МД.Реквизиты.Найти(ИмяРекв);
    Если РеквизитМД = Неопределено Тогда
        Сообщить("Реквизит «" + ИмяРекв + "» не найден в справочнике", СтатусСообщения.Важное);
        Возврат Итог;
    КонецЕсли;
    ЭтоХранилище = РеквизитМД.Тип.СодержитТип(Тип("ХранилищеЗначения"));

    // Обрабатываем в алфавитном порядке: при нескольких файлах на элемент берётся первый
    Список = Новый СписокЗначений;
    Для Каждого Файл Из Файлы Цикл
        Список.Добавить(Файл, Файл.Имя);
    КонецЦикла;
    Список.СортироватьПоПредставлению();

    Сообщить("Загрузка картинок в «" + МД.Синоним + "», поиск по «" + ИмяКлюча + "»");
    Сообщить("Файлов: " + Список.Количество());
    Сообщить("----------------------------------------");

    Обработанные = Новый Соответствие;

    Для Каждого ЭлементСписка Из Список Цикл

        Файл = ЭлементСписка.Значение;

        Ссылка = Неопределено;
        Для Каждого Вариант Из ВариантыКлючаИзИмениФайла(Файл.Имя) Цикл
            Попытка
                Ссылка = НайтиСсылкуПоКлючу(МД, Истина, ИмяКлюча, Вариант);
            Исключение
                Ссылка = Неопределено;
            КонецПопытки;
            Если Ссылка <> Неопределено Тогда
                Прервать;
            КонецЕсли;
        КонецЦикла;

        Если Ссылка = Неопределено Тогда
            Итог.НеНайдено = Итог.НеНайдено + 1;
            Сообщить("Не найден элемент для файла «" + Файл.Имя + "»");
        ИначеЕсли Обработанные[Ссылка] <> Неопределено Тогда
            Итог.Пропущено = Итог.Пропущено + 1;
            Сообщить("Файл «" + Файл.Имя + "» пропущен: для «" + Ссылка + "» уже взят «"
                + Обработанные[Ссылка] + "»");
        Иначе
            Обработанные.Вставить(Ссылка, Файл.Имя);

            Попытка
                ЭлементОбъект = Ссылка.ПолучитьОбъект();

                УжеЕсть = Ложь;
                Если ЭтоХранилище Тогда
                    УжеЕсть = (ЭлементОбъект[ИмяРекв].Получить() <> Неопределено);
                Иначе
                    УжеЕсть = (ЭлементОбъект[ИмяРекв] <> Неопределено);
                КонецЕсли;

                Если УжеЕсть И Не ЭтаФорма.КартинкиЗаменять Тогда
                    Итог.Пропущено = Итог.Пропущено + 1;
                    Сообщить("«" + Ссылка + "»: картинка уже есть — пропущено");
                Иначе
                    Данные = ПолучитьИзВременногоХранилища(Файл.Адрес);
                    Если ЭтоХранилище Тогда
                        ЭлементОбъект[ИмяРекв] = Новый ХранилищеЗначения(Данные);
                    Иначе
                        ЭлементОбъект[ИмяРекв] = Данные;
                    КонецЕсли;
                    ЭлементОбъект.Записать();
                    Итог.Загружено = Итог.Загружено + 1;
                    Сообщить("«" + Ссылка + "» ← " + Файл.Имя);
                КонецЕсли;
            Исключение
                Сообщить("Ошибка для файла «" + Файл.Имя + "»: " + ОписаниеОшибки(),
                    СтатусСообщения.Важное);
            КонецПопытки;
        КонецЕсли;

        Попытка
            УдалитьИзВременногоХранилища(Файл.Адрес);
        Исключение
        КонецПопытки;

    КонецЦикла;

    // Элементам без картинки — картинка по умолчанию
    Если Не ПустаяСтрока(АдресПоУмолчанию) Тогда
        ЗаполнитьКартинкойПоУмолчанию(МД, ИмяРекв, ЭтоХранилище, АдресПоУмолчанию, Итог);
    КонецЕсли;

    Сообщить("----------------------------------------");
    Сообщить("Загружено из папки: " + Итог.Загружено);
    Сообщить("Подставлена картинка по умолчанию: " + Итог.ПоУмолчанию);
    Сообщить("Пропущено: " + Итог.Пропущено);
    Сообщить("Не найдено элементов: " + Итог.НеНайдено);

    Возврат Итог;

КонецФункции

// «10.jpg» -> «10»;  «10_фото.jpg» -> «10»;  «Товар 10 (2).png» -> «10»
&НаСервереБезКонтекста
Функция ВариантыКлючаИзИмениФайла(Знач ИмяФайла)

    Варианты = Новый Массив;

    // Имя без расширения
    Имя = ИмяФайла;
    Для н = 1 По СтрДлина(ИмяФайла) Цикл
        Позиция = СтрДлина(ИмяФайла) - н + 1;
        Если Сред(ИмяФайла, Позиция, 1) = "." Тогда
            Имя = Лев(ИмяФайла, Позиция - 1);
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Имя = СокрЛП(Имя);
    ДобавитьВариант(Варианты, Имя);

    // Часть до первого разделителя
    Для н = 1 По СтрДлина(Имя) Цикл
        Символ = Сред(Имя, н, 1);
        Если Символ = "_" Или Символ = " " Или Символ = "-" Или Символ = "(" Тогда
            ДобавитьВариант(Варианты, Лев(Имя, н - 1));
            Прервать;
        КонецЕсли;
    КонецЦикла;

    // Первая группа цифр
    Группа = "";
    Для н = 1 По СтрДлина(Имя) Цикл
        Символ = Сред(Имя, н, 1);
        Если Найти("0123456789", Символ) > 0 Тогда
            Группа = Группа + Символ;
        ИначеЕсли Не ПустаяСтрока(Группа) Тогда
            Прервать;
        КонецЕсли;
    КонецЦикла;
    ДобавитьВариант(Варианты, Группа);

    Возврат Варианты;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьВариант(Варианты, Знач Текст)

    Текст = СокрЛП(Текст);
    Если Не ПустаяСтрока(Текст) И Варианты.Найти(Текст) = Неопределено Тогда
        Варианты.Добавить(Текст);
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКартинкойПоУмолчанию(МД, ИмяРекв, ЭтоХранилище, Адрес, Итог)

    Данные = ПолучитьИзВременногоХранилища(Адрес);

    Выборка = Справочники[МД.Имя].Выбрать();
    Пока Выборка.Следующий() Цикл

        Если Выборка.ПометкаУдаления Тогда
            Продолжить;
        КонецЕсли;

        Попытка
            Если Выборка.ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
        Исключение
        КонецПопытки;

        Попытка
            ЭлементОбъект = Выборка.ПолучитьОбъект();

            Если ЭтоХранилище Тогда
                Пусто = (ЭлементОбъект[ИмяРекв].Получить() = Неопределено);
            Иначе
                Пусто = (ЭлементОбъект[ИмяРекв] = Неопределено);
            КонецЕсли;

            Если Пусто Тогда
                Если ЭтоХранилище Тогда
                    ЭлементОбъект[ИмяРекв] = Новый ХранилищеЗначения(Данные);
                Иначе
                    ЭлементОбъект[ИмяРекв] = Данные;
                КонецЕсли;
                ЭлементОбъект.Записать();
                Итог.ПоУмолчанию = Итог.ПоУмолчанию + 1;
                Сообщить("«" + Выборка.Ссылка + "»: картинки не было — подставлена по умолчанию");
            КонецЕсли;
        Исключение
            Сообщить("Ошибка при подстановке картинки по умолчанию: " + ОписаниеОшибки(),
                СтатусСообщения.Важное);
        КонецПопытки;

    КонецЦикла;

    Попытка
        УдалитьИзВременногоХранилища(Адрес);
    Исключение
    КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура НастроитьПоведениеЭлементов()

    // Эти поля заполняются только выбором из списка — опечатки невозможны
    Имена = Новый Массив;
    Имена.Добавить("Импорт_ТипОбъектаДокумента");
    Имена.Добавить("Импорт_ИмяТабличнойЧастиДокумента");
    Имена.Добавить("Импорт_КлючевоеПолеШапки");
    Имена.Добавить("Импорт_КлючевоеПолеТЧ");
    Имена.Добавить("КартинкиКлюч");
    Имена.Добавить("КартинкиРеквизит");
    Для Каждого Имя Из Имена Цикл
        Элемент = Элементы.Найти(Имя);
        Если Элемент <> Неопределено Тогда
            Попытка
                Элемент.РедактированиеТекста = Ложь;
            Исключение
            КонецПопытки;
        КонецЕсли;
    КонецЦикла;

    // Красная отметка у обязательного поля
    Попытка
        Элементы.Импорт_ТипОбъектаДокумента.АвтоОтметкаНезаполненного = Истина;
    Исключение
    КонецПопытки;

    Попытка
        Элементы.Импорт_ПерваяСтрокаДанных.УстановитьДействие("ПриИзменении", "ПерваяСтрокаПриИзменении");
    Исключение
    КонецПопытки;

    Попытка
        Элементы.Импорт_КлючевоеПолеШапки.УстановитьДействие("ПриИзменении", "КлючШапкиПриИзменении");
    Исключение
    КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура УстановитьСвойства(ИмяЭлемента, НовыйЗаголовок = Неопределено, НоваяПодсказка = Неопределено)

    Элемент = Элементы.Найти(ИмяЭлемента);
    Если Элемент = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Если НовыйЗаголовок <> Неопределено Тогда
        Попытка
            Элемент.Заголовок = НовыйЗаголовок;
        Исключение
        КонецПопытки;
    КонецЕсли;

    Если НоваяПодсказка <> Неопределено Тогда
        Попытка
            Элемент.Подсказка = НоваяПодсказка;
        Исключение
        КонецПопытки;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибку(Текст, ПутьКПолю = "")

    Если Не ПустаяСтрока(ПутьКПолю) Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = Текст;
        Сообщение.Поле = ПутьКПолю;
        Сообщение.Сообщить();
    КонецЕсли;
    ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПерваяСтрокаПриИзменении(Элемент)

    Если Не ЗначениеЗаполнено(Объект.Импорт_ПерваяСтрокаДанных) Или Объект.Импорт_ПерваяСтрокаДанных < 2 Тогда
        Объект.Импорт_ПерваяСтрокаДанных = 2;
        ПоказатьОповещениеПользователя("Первая строка данных исправлена на 2", ,
            "Строка 1 — заголовки колонок, данные начинаются со строки 2.");
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПослеВопроса(Результат, ДополнительныеПараметры) Экспорт

    Если Результат <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ОчиститьСообщения();
    ОчиститьДанныеНаСервере();
    ПоказатьОповещениеПользователя("Данные очищены", , "Заголовки колонок восстановлены.");

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПослеВопроса(Результат, ДополнительныеПараметры) Экспорт

    Если Результат <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    ОчиститьСообщения();

    Попытка
        Итог = ЗагрузитьДанныеНаСервере();
    Исключение
        ПоказатьПредупреждение(, "Загрузка прервана из-за ошибки: "
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат;
    КонецПопытки;

    ПоказатьОповещениеПользователя("Загрузка завершена", ,
        "Создано: " + Итог.Создано + ", обновлено: " + Итог.Обновлено + ", ошибок: " + Итог.Ошибок);

    Если Итог.Ошибок > 0 Тогда
        ПоказатьПредупреждение(, "Часть записей не загружена (ошибок: " + Итог.Ошибок
            + "). Подробности — в окне сообщений.");
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьДанныеНаСервере()

    Результат = Новый Структура("Ошибки, Предупреждения, СтрокШапки, СтрокТЧ, Создать, Обновить, Пропустить, Объединено",
        Новый Массив, Новый Массив, 0, 0, 0, 0, 0, 0);

    МД = ОбъектМетаданных();
    Если МД = Неопределено Тогда
        Результат.Ошибки.Добавить("• Не найден объект «" + Объект.Импорт_ТипОбъектаДокумента + "» в конфигурации.");
        Возврат Результат;
    КонецЕсли;

    ЭтоСправочник = (ЭтаФорма.РежимИмпорта = "Справочник");
    ЕстьТЧ = Объект.Импорт_ЕстьТабличнаяЧасть;
    ИмяКлюча = ?(ПустаяСтрока(Объект.Импорт_КлючевоеПолеШапки),
        ИмяКлючаПоУмолчанию(), Объект.Импорт_КлючевоеПолеШапки);
    АвтоКлюч = (ИмяКлюча = ИмяАвтоКлюча());

    // --- Шапка: заголовки ---
    ЗаголовкиШапки = ЗаголовкиШапкиТаблицы(МД);
    Если ЗаголовкиШапки.Количество() = 0 Тогда
        Результат.Ошибки.Добавить("• В первой строке таблицы нет заголовков колонок. "
            + "Нажмите «Очистить» — заголовки вернутся, и вставьте данные заново.");
        Возврат Результат;
    КонецЕсли;

    Если ЗаголовкиШапки.Получить(ИмяКлюча) = Неопределено И Не АвтоКлюч Тогда
        Результат.Ошибки.Добавить("• В таблице нет колонки ключа «" + ИмяКлюча + "». Выберите другой ключ "
            + "или нажмите «Очистить» и вставьте данные заново, не затрагивая 1-ю строку.");
        Возврат Результат;
    КонецЕсли;

    Стандартные = СтандартныеКолонкиШапки();
    Для Каждого КлючИЗначение Из ЗаголовкиШапки Цикл
        Если Стандартные.Найти(КлючИЗначение.Ключ) = Неопределено
            И МД.Реквизиты.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
            Результат.Предупреждения.Добавить("• Колонка «" + КлючИЗначение.Ключ
                + "» не найдена среди реквизитов — она будет пропущена.");
        КонецЕсли;
    КонецЦикла;

    // --- Шапка: строки и ключи ---
    СтрокиШапки = ПрочитатьСтроки(Объект.Импорт_ТабличныйДокумент, ЗаголовкиШапки,
        Макс(2, Объект.Импорт_ПерваяСтрокаДанных));

    Если СтрокиШапки.Количество() > 0 Тогда
        Объединение = ОбъединитьСтрокиШапки(СтрокиШапки, ИмяКлюча);
        СтрокиШапки = Объединение.Строки;
        Результат.Объединено = Объединение.Объединено;
    КонецЕсли;
    Результат.СтрокШапки = СтрокиШапки.Количество();

    Если СтрокиШапки.Количество() = 0 Тогда
        Результат.Ошибки.Добавить("• Нет заполненных строк данных, начиная со строки "
            + Макс(2, Объект.Импорт_ПерваяСтрокаДанных) + ".");
        Возврат Результат;
    КонецЕсли;

    КлючиШапки = Новый Соответствие;
    Повторы = Новый Соответствие;
    БезКлюча = 0;
    ОшибокПоиска = 0;

    Для Каждого СтрокаШапки Из СтрокиШапки Цикл

        ТекстКлюча = СтрокаШапки.Получить(ИмяКлюча);
        Если ТекстКлюча = Неопределено Тогда
            ТекстКлюча = "";
        КонецЕсли;

        Если ПустаяСтрока(ТекстКлюча) Тогда
            Если АвтоКлюч Тогда
                Результат.Создать = Результат.Создать + 1;
            Иначе
                БезКлюча = БезКлюча + 1;
                Результат.Пропустить = Результат.Пропустить + 1;
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        Сопоставимый = КлючДляСопоставления(ТекстКлюча);
        Если КлючиШапки[Сопоставимый] <> Неопределено Тогда
            Повторы.Вставить(ТекстКлюча, Истина);
        КонецЕсли;
        КлючиШапки.Вставить(Сопоставимый, Истина);

        Ссылка = Неопределено;
        Попытка
            Ссылка = НайтиСсылкуПоКлючу(МД, ЭтоСправочник, ИмяКлюча, ТекстКлюча);
        Исключение
            ОшибокПоиска = ОшибокПоиска + 1;
        КонецПопытки;

        Если Ссылка <> Неопределено Тогда
            Результат.Обновить = Результат.Обновить + 1;
        ИначеЕсли Объект.Импорт_НеСоздаватьНовыеДокументы Тогда
            Результат.Пропустить = Результат.Пропустить + 1;
        Иначе
            Результат.Создать = Результат.Создать + 1;
        КонецЕсли;

    КонецЦикла;

    Если БезКлюча > 0 Тогда
        Результат.Предупреждения.Добавить("• Строк без значения ключа «" + ИмяКлюча + "»: " + БезКлюча
            + " — они будут пропущены.");
    КонецЕсли;

    Если Повторы.Количество() > 0 Тогда
        Примеры = Новый Массив;
        Для Каждого КлючИЗначение Из Повторы Цикл
            Если Примеры.Количество() < 3 Тогда
                Примеры.Добавить("«" + КлючИЗначение.Ключ + "»");
            КонецЕсли;
        КонецЦикла;
        Результат.Предупреждения.Добавить("• Повторяющиеся значения ключа (" + СтрСоединить(Примеры, ", ")
            + "): объект будет записан несколько раз, последняя строка перезапишет предыдущие.");
    КонецЕсли;

    Если ОшибокПоиска > 0 Тогда
        Результат.Предупреждения.Добавить("• Не удалось выполнить поиск по ключу для строк: " + ОшибокПоиска
            + ". Проверьте, что выбран подходящий ключ.");
    КонецЕсли;

    // --- Табличная часть ---
    Если Не ЕстьТЧ Тогда
        Возврат Результат;
    КонецЕсли;

    МДТЧ = МД.ТабличныеЧасти.Найти(Объект.Импорт_ИмяТабличнойЧастиДокумента);
    Если МДТЧ = Неопределено Тогда
        Результат.Ошибки.Добавить("• Не найдена табличная часть «" + Объект.Импорт_ИмяТабличнойЧастиДокумента + "».");
        Возврат Результат;
    КонецЕсли;

    ЗаголовкиТЧ = ЗаголовкиТаблицыТЧ(МДТЧ);
    ИмяКолонкиКлюча = ИмяКолонкиКлючаТЧ();

    Если ПустаяСтрока(ИмяКолонкиКлюча) Тогда
        Результат.Ошибки.Добавить("• Выберите «Ключ ТЧ» — поле табличной части, по которому строки "
            + "связываются с шапкой (например, «Номер заказа»).");
        Возврат Результат;
    КонецЕсли;

    Если ЗаголовкиТЧ.Получить(ИмяКолонкиКлюча) = Неопределено Тогда
        Результат.Ошибки.Добавить("• В таблице табличной части нет колонки «" + ИмяКолонкиКлюча
            + "». Вставьте её вместе с данными (заголовок можно писать как в Excel) "
            + "или убедитесь, что в шапке и табличной части одинаковое число строк.");
        Возврат Результат;
    КонецЕсли;

    Для Каждого КлючИЗначение Из ЗаголовкиТЧ Цикл
        Если КлючИЗначение.Ключ <> ИмяКолонкиКлюча И МДТЧ.Реквизиты.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
            Результат.Предупреждения.Добавить("• Колонка табличной части «" + КлючИЗначение.Ключ
                + "» не найдена среди реквизитов — она будет пропущена.");
        КонецЕсли;
    КонецЦикла;

    СтрокиТЧ = ПрочитатьСтроки(Объект.Импорт_ТабличныйДокументТЧ, ЗаголовкиТЧ, 2);
    Результат.СтрокТЧ = СтрокиТЧ.Количество();

    Если СтрокиТЧ.Количество() = 0 Тогда
        Результат.Предупреждения.Добавить("• Таблица табличной части пуста — табличные части заполнены не будут.");
        Возврат Результат;
    КонецЕсли;

    // Связь строк ТЧ с шапкой (с автопродолжением ключа)
    ПредыдущийКлюч = "";
    КлючиТЧ = Новый Соответствие;
    ВсегоКлючей = 0;
    Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
        ТекстКлюча = СтрокаТЧ.Получить(ИмяКолонкиКлюча);
        Если ТекстКлюча = Неопределено Или ПустаяСтрока(ТекстКлюча) Тогда
            ТекстКлюча = ПредыдущийКлюч;
        Иначе
            ПредыдущийКлюч = ТекстКлюча;
        КонецЕсли;
        Если Не ПустаяСтрока(ТекстКлюча) Тогда
            КлючиТЧ.Вставить(КлючДляСопоставления(ТекстКлюча), Истина);
            ВсегоКлючей = ВсегоКлючей + 1;
        КонецЕсли;
    КонецЦикла;

    Если ВсегоКлючей = 0 И Результат.СтрокШапки > 1 Тогда
        Результат.Ошибки.Добавить("• Не удалось связать строки табличной части с шапкой. "
            + "Вставьте в таблицу шапки столько же строк, сколько в табличной части (ключ повторяется "
            + "для каждой строки), и в том же порядке — либо заполните в табличной части колонку «" + ИмяКолонкиКлюча + "».");
        Возврат Результат;
    КонецЕсли;

    Если ВсегоКлючей > 0 Тогда

        НеНайдено = Новый Массив;
        Для Каждого КлючИЗначение Из КлючиТЧ Цикл
            Если КлючиШапки[КлючИЗначение.Ключ] = Неопределено Тогда
                НеНайдено.Добавить("«" + КлючИЗначение.Ключ + "»");
            КонецЕсли;
        КонецЦикла;
        Если НеНайдено.Количество() > 0 Тогда
            Результат.Предупреждения.Добавить("• Ключи табличной части, которых нет в шапке: "
                + СтрСоединить(НеНайдено, ", ") + " — эти строки не загрузятся.");
        КонецЕсли;

        БезСтрок = 0;
        Для Каждого КлючИЗначение Из КлючиШапки Цикл
            Если КлючиТЧ[КлючИЗначение.Ключ] = Неопределено Тогда
                БезСтрок = БезСтрок + 1;
            КонецЕсли;
        КонецЦикла;
        Если БезСтрок > 0 Тогда
            Результат.Предупреждения.Добавить("• Для " + БезСтрок
                + " строк шапки нет строк в табличной части — их табличная часть останется как есть.");
        КонецЕсли;

    КонецЕсли;

    Возврат Результат;

КонецФункции

