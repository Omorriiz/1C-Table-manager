
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    // Динамический реквизит «Что загружаем»: Документ / Справочник (таблица)
    НовыеРеквизиты = Новый Массив;
    НовыеРеквизиты.Добавить(Новый РеквизитФормы("РежимИмпорта", Новый ОписаниеТипов("Строка")));
    НовыеРеквизиты.Добавить(Новый РеквизитФормы("КартинкиПапка", Новый ОписаниеТипов("Строка")));
    НовыеРеквизиты.Добавить(Новый РеквизитФормы("КартинкиКлюч", Новый ОписаниеТипов("Строка")));
    НовыеРеквизиты.Добавить(Новый РеквизитФормы("КартинкиРеквизит", Новый ОписаниеТипов("Строка")));
    НовыеРеквизиты.Добавить(Новый РеквизитФормы("КартинкиЗаменять", Новый ОписаниеТипов("Булево")));
    НовыеРеквизиты.Добавить(Новый РеквизитФормы("КартинкиПоУмолчанию", Новый ОписаниеТипов("Строка")));
    ИзменитьРеквизиты(НовыеРеквизиты);
    ЭтаФорма.РежимИмпорта = "Документ";

    Попытка
        СоздатьЭлементыУправления();
    Исключение
        Сообщить("Не удалось создать переключатель режима: " + ОписаниеОшибки(),
            СтатусСообщения.Важное);
    КонецПопытки;

    ЗаполнитьСписокТипов();

    // Значения по умолчанию
    Если Не ЗначениеЗаполнено(Объект.Импорт_ПерваяСтрокаДанных) Тогда
        Объект.Импорт_ПерваяСтрокаДанных = 2;
    КонецЕсли;

    // Ключ табличной части теперь отдельная колонка «Ключ» — выбирать вручную не нужно

    НастроитьПоведениеЭлементов();

    ОбновитьТексты();

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыУправления()

    Переключатель = Элементы.Вставить("РежимИмпорта", Тип("ПолеФормы"),
        Элементы.ГруппаШапка, Элементы.Импорт_ТипОбъектаДокумента);
    Переключатель.Вид = ВидПоляФормы.ПолеПереключателя;
    Переключатель.ПутьКДанным = "РежимИмпорта";
    Переключатель.Заголовок = "Что загружаем";
    Переключатель.СписокВыбора.Добавить("Документ", "Документ");
    Переключатель.СписокВыбора.Добавить("Справочник", "Таблица (справочник)");
    Переключатель.УстановитьДействие("ПриИзменении", "РежимИмпортаПриИзменении");

    Попытка
        СоздатьГруппуКартинок();
    Исключение
        Сообщить("Не удалось создать блок картинок: " + ОписаниеОшибки(), СтатусСообщения.Важное);
    КонецПопытки;

    Попытка
        Инструкция = Элементы.Вставить("Инструкция", Тип("ДекорацияФормы"),
            , Элементы.ГруппаШапка);
    Исключение
        Инструкция = Элементы.Вставить("Инструкция", Тип("ДекорацияФормы"),
            Элементы.ГруппаШапка, Переключатель);
    КонецПопытки;
    Инструкция.Вид = ВидДекорацииФормы.Надпись;
    Попытка
        Инструкция.ЦветТекста = Новый Цвет(100, 100, 100);
    Исключение
    КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СоздатьГруппуКартинок()

    // Группа идёт после кнопок «Загрузить / Очистить»: картинки — отдельный шаг после загрузки данных
    Группа = Элементы.Вставить("ГруппаКартинки", Тип("ГруппаФормы"));
    Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Группа.Заголовок = "4. Картинки";

    Поле = Элементы.Вставить("КартинкиПапка", Тип("ПолеФормы"), Группа);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = "КартинкиПапка";
    Поле.Заголовок = "Папка с картинками";
    Поле.КнопкаВыбора = Истина;
    Поле.УстановитьДействие("НачалоВыбора", "КартинкиПапкаНачалоВыбора");

    Поле = Элементы.Вставить("КартинкиКлюч", Тип("ПолеФормы"), Группа);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = "КартинкиКлюч";
    Поле.Заголовок = "Искать элемент по";

    Поле = Элементы.Вставить("КартинкиРеквизит", Тип("ПолеФормы"), Группа);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = "КартинкиРеквизит";
    Поле.Заголовок = "Записать картинку в";

    Поле = Элементы.Вставить("КартинкиЗаменять", Тип("ПолеФормы"), Группа);
    Поле.Вид = ВидПоляФормы.ПолеФлажка;
    Поле.ПутьКДанным = "КартинкиЗаменять";
    Поле.Заголовок = "Заменять существующие картинки";

    Поле = Элементы.Вставить("КартинкиПоУмолчанию", Тип("ПолеФормы"), Группа);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = "КартинкиПоУмолчанию";
    Поле.Заголовок = "Картинка, если у элемента её нет";
    Поле.КнопкаВыбора = Истина;
    Поле.УстановитьДействие("НачалоВыбора", "КартинкиПоУмолчаниюНачалоВыбора");

    Команда = Команды.Добавить("ЗагрузитьКартинки");
    Команда.Заголовок = "Загрузить картинки";
    Команда.Действие = "КомандаЗагрузитьКартинки";

    Кнопка = Элементы.Вставить("ЗагрузитьКартинки", Тип("КнопкаФормы"), Группа);
    Кнопка.ИмяКоманды = "ЗагрузитьКартинки";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    УправлениеВидимостью();
КонецПроцедуры

// УПРАВЛЕНИЕ ВИДИМОСТЬЮ И ТЕКСТАМИ

&НаКлиенте
Процедура УправлениеВидимостью()

    ТипВыбран = Не ПустаяСтрока(Объект.Импорт_ТипОбъектаДокумента);
    ЭтоСправочник = (ЭтаФорма.РежимИмпорта = "Справочник");
    ЕстьТЧ = ТипВыбран И Объект.Импорт_ЕстьТабличнаяЧасть;

    // Лишнее не показываем, пока не выбран объект загрузки
    Элементы.Импорт_ЕстьТабличнаяЧасть.Видимость = ТипВыбран;
    Элементы.Импорт_ИмяТабличнойЧастиДокумента.Видимость = ЕстьТЧ;
    Элементы.Импорт_КлючевоеПолеШапки.Видимость = ТипВыбран;
    Элементы.Импорт_КлючевоеПолеТЧ.Видимость = ЕстьТЧ;
    Элементы.Импорт_ПерваяСтрокаДанных.Видимость = ТипВыбран;
    Элементы.Импорт_НеСоздаватьНовыеДокументы.Видимость = ТипВыбран;
    Элементы.Импорт_ПроводитьДокументы.Видимость = ТипВыбран И Не ЭтоСправочник;
    Элементы.ГруппаДанныеШапки.Видимость = ТипВыбран;
    Элементы.ГруппаДанныеТЧ.Видимость = ЕстьТЧ;
    Элементы.Загрузить.Доступность = ТипВыбран;
    Элементы.Очистить.Доступность = ТипВыбран;

    Попытка
        Элементы.ГруппаКартинки.Видимость = ТипВыбран И ЭтоСправочник;
    Исключение
    КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбновитьТексты()

    ЭтоСправочник = (ЭтаФорма.РежимИмпорта = "Справочник");
    ТипВыбран = Не ПустаяСтрока(Объект.Импорт_ТипОбъектаДокумента);

    // Заголовки шагов
    УстановитьСвойства("ГруппаШапка", "1. Что и куда загружаем");
    УстановитьСвойства("ГруппаДанныеШапки", ?(ЭтоСправочник,
        "2. Данные справочника — одна строка = один элемент",
        "2. Данные шапки — одна строка = один документ"));
    УстановитьСвойства("ГруппаДанныеТЧ", "3. Табличная часть — одна строка = одна строка ТЧ");
    УстановитьСвойства("ГруппаКартинки", "4. Картинки (необязательно, после загрузки данных)");

    Для Каждого ИмяГруппы Из Новый Структура("ГруппаШапка, ГруппаДанныеШапки, ГруппаДанныеТЧ, ГруппаКартинки") Цикл
        Элемент = Элементы.Найти(ИмяГруппы.Ключ);
        Если Элемент <> Неопределено Тогда
            Попытка
                Элемент.ОтображатьЗаголовок = Истина;
            Исключение
            КонецПопытки;
        КонецЕсли;
    КонецЦикла;

    // Поля и подсказки (всплывают при наведении мыши)
    УстановитьСвойства("РежимИмпорта", "Что загружаем",
        "Документ — шапка и (при необходимости) табличная часть. Таблица — элементы справочника.");
    УстановитьСвойства("Импорт_ТипОбъектаДокумента", ?(ЭтоСправочник, "Справочник", "Документ"),
        ?(ЭтоСправочник, "В какой справочник загружаем данные.", "Какой вид документа загружаем."));
    УстановитьСвойства("Импорт_ЕстьТабличнаяЧасть", "Есть табличная часть",
        "Включите, если вместе с шапкой нужно загрузить строки табличной части.");
    УстановитьСвойства("Импорт_ИмяТабличнойЧастиДокумента", "Табличная часть",
        "В какую табличную часть загружать строки.");
    УстановитьСвойства("Импорт_КлючевоеПолеШапки", "Ключ (по чему искать)",
        "Поле, по которому ищется уже существующий объект. Найден — обновляется, не найден — создаётся новый. "
        + "Значения ключа в таблице должны быть уникальны.");
    УстановитьСвойства("Импорт_КлючевоеПолеТЧ", "Ключ ТЧ (поле строки ТЧ)",
        "Поле строки табличной части, в котором записан ключ документа (например, «Номер заказа» = номер документа). "
        + "По нему строки связываются с шапкой. Подбирается автоматически, при необходимости измените.");
    УстановитьСвойства("Импорт_ПерваяСтрокаДанных", "Первая строка данных",
        "Номер строки, с которой начинаются данные. Строка 1 — заголовки колонок, поэтому минимум 2.");
    УстановитьСвойства("Импорт_НеСоздаватьНовыеДокументы",
        ?(ЭтоСправочник, "Только обновлять существующие", "Не создавать новые"),
        "Если включено, объекты, которых ещё нет, пропускаются, а не создаются.");
    УстановитьСвойства("Импорт_ПроводитьДокументы", "Проводить документы",
        "Документы будут не только записаны, но и проведены.");

    УстановитьСвойства("Загрузить", Неопределено,
        "Проверит данные, покажет, что будет создано и обновлено, и после вашего подтверждения загрузит их.");
    УстановитьСвойства("Очистить", Неопределено,
        "Удалит вставленные данные и вернёт заголовки колонок.");

    УстановитьСвойства("КартинкиПапка", "Папка с картинками",
        "Папка с файлами jpg, png, bmp, gif. Ключ элемента берётся из имени файла: «10.jpg» → 10.");
    УстановитьСвойства("КартинкиКлюч", "Искать элемент по",
        "Какое поле справочника сравнивается с ключом из имени файла. Обычно «Код».");
    УстановитьСвойства("КартинкиРеквизит", "Записать картинку в",
        "Реквизит справочника для хранения картинки (тип «Хранилище значения» или «Двоичные данные»).");
    УстановитьСвойства("КартинкиЗаменять", "Заменять существующие картинки",
        "Если выключено, у элементов с уже загруженной картинкой она останется прежней.");
    УстановитьСвойства("КартинкиПоУмолчанию", "Картинка, если у элемента её нет",
        "Необязательно. Этой картинкой заполнятся все элементы справочника, у которых после загрузки картинки нет.");
    УстановитьСвойства("ЗагрузитьКартинки", Неопределено,
        "Загрузит картинки из папки в элементы справочника.");

    // Подсказка-инструкция под заголовком
    Попытка
        Если Не ТипВыбран Тогда
            Элементы.Инструкция.Заголовок = ?(ЭтоСправочник,
                "Шаг 1: выберите справочник, в который нужно загрузить данные.",
                "Шаг 1: выберите документ, который нужно загрузить.");
        ИначеЕсли ЭтоСправочник Тогда
            Элементы.Инструкция.Заголовок =
                "Шаг 2: вставьте данные из Excel в таблицу со 2-й строки (первую — с заголовками — не меняйте)."
                + Символы.ПС
                + "Жёлтая колонка — ключ: по ней ищется существующий элемент. Код можно оставить пустым — он присвоится автоматически."
                + Символы.ПС
                + "Ошиблись или сбили заголовки? Кнопка «Очистить» вернёт таблицу в исходный вид.";
        Иначе
            Элементы.Инструкция.Заголовок =
                "Шаг 2: вставьте данные из Excel в таблицы со 2-й строки (первую — с заголовками — не меняйте)."
                + Символы.ПС
                + "Жёлтая колонка — ключ: по ней ищется существующий документ, и ею же связываются строки табличной части. "
                + "Данные можно вставлять вместе со строкой заголовков из Excel (с ячейки A1): колонки сопоставятся по названию, "
                + "порядок не важен, лишние колонки (например, «код тб») пропустятся. "
                + "«Ключ ТЧ» (например, «Номер заказа») — это номер документа, к которому относится строка. "
                + "Если его нет в таблице или он пустой, он проставится автоматически по ключу шапки. "
                + "Повторяющиеся значения ключа в шапке объединяются в один документ."
                + Символы.ПС
                + "Номер можно оставить пустым — он присвоится автоматически. Кнопка «Очистить» вернёт таблицы в исходный вид.";
        КонецЕсли;
    Исключение
    КонецПопытки;

КонецПроцедуры

// ОБРАБОТЧИКИ ЭЛЕМЕНТОВ

&НаКлиенте
Процедура РежимИмпортаПриИзменении(Элемент)
    ПрименитьРежимНаСервере();
    УправлениеВидимостью();
КонецПроцедуры

&НаКлиенте
Процедура Импорт_ТипОбъектаДокументаПриИзменении(Элемент)
    ПриИзмененииТипаНаСервере();
    УправлениеВидимостью();
КонецПроцедуры

&НаКлиенте
Процедура Импорт_ЕстьТабличнаяЧастьПриИзменении(Элемент)

    Ошибка = ПриИзмененииЕстьТЧНаСервере();
    Если Не ПустаяСтрока(Ошибка) Тогда
        ПоказатьПредупреждение(, Ошибка);
    КонецЕсли;
    УправлениеВидимостью();

КонецПроцедуры

&НаКлиенте
Процедура Импорт_ИмяТабличнойЧастиДокументаПриИзменении(Элемент)
    ПриИзмененииТЧНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КлючШапкиПриИзменении(Элемент)
    ПодсветитьКлючи();
КонецПроцедуры

&НаСервере
Процедура ПрименитьРежимНаСервере()

    Объект.Импорт_ТипОбъектаДокумента = "";
    Объект.Импорт_ИмяТабличнойЧастиДокумента = "";
    Объект.Импорт_КлючевоеПолеШапки = "";
    Объект.Импорт_КлючевоеПолеТЧ = "";
    Объект.Импорт_ЕстьТабличнаяЧасть = Ложь;
    Элементы.Импорт_ЕстьТабличнаяЧасть.Доступность = Истина;

    ЗаполнитьСписокТипов();
    ЗаполнитьСписокТЧ();
    ЗаполнитьСписокКлючейШапки();
    ЗаполнитьЗаголовкиШапки();
    ОбновитьСпискиКартинок();
    Объект.Импорт_ТабличныйДокументТЧ.Очистить();
    ОбновитьТексты();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииТипаНаСервере()

    Объект.Импорт_ИмяТабличнойЧастиДокумента = "";
    Объект.Импорт_КлючевоеПолеШапки = "";

    // Табличная часть включается сама, если она есть у объекта
    МД = ОбъектМетаданных();
    ЕстьТабличные = (МД <> Неопределено И МД.ТабличныеЧасти.Количество() > 0);
    Объект.Импорт_ЕстьТабличнаяЧасть = ЕстьТабличные;
    Элементы.Импорт_ЕстьТабличнаяЧасть.Доступность = ЕстьТабличные;

    ЗаполнитьСписокТЧ();
    ЗаполнитьСписокКлючейШапки();
    ЗаполнитьЗаголовкиШапки();
    ЗаполнитьЗаголовкиТЧ();
    ОбновитьСпискиКартинок();
    ОбновитьТексты();

КонецПроцедуры

&НаСервере
Функция ПриИзмененииЕстьТЧНаСервере()

    Если Объект.Импорт_ЕстьТабличнаяЧасть Тогда

        МД = ОбъектМетаданных();
        Если МД = Неопределено Тогда
            Объект.Импорт_ЕстьТабличнаяЧасть = Ложь;
            Возврат "Сначала выберите, что загружаем (документ или справочник).";
        КонецЕсли;

        Если МД.ТабличныеЧасти.Количество() = 0 Тогда
            Объект.Импорт_ЕстьТабличнаяЧасть = Ложь;
            Возврат "У «" + МД.Синоним + "» нет табличных частей — загружать нечего.";
        КонецЕсли;

        ЗаполнитьСписокТЧ();
        ЗаполнитьЗаголовкиТЧ();

    Иначе
        Объект.Импорт_ТабличныйДокументТЧ.Очистить();
    КонецЕсли;

    Возврат "";

КонецФункции

// СПИСКИ ВЫБОРА

&НаСервере
Функция ОбъектМетаданных()

    Если ПустаяСтрока(Объект.Импорт_ТипОбъектаДокумента) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если ЭтаФорма.РежимИмпорта = "Справочник" Тогда
        Возврат Метаданные.Справочники.Найти(Объект.Импорт_ТипОбъектаДокумента);
    КонецЕсли;

    Возврат Метаданные.Документы.Найти(Объект.Импорт_ТипОбъектаДокумента);

КонецФункции

&НаСервере
Процедура ЗаполнитьСписокТипов()

    Список = Элементы.Импорт_ТипОбъектаДокумента.СписокВыбора;
    Список.Очистить();

    Если ЭтаФорма.РежимИмпорта = "Справочник" Тогда
        Для Каждого МДОбъект Из Метаданные.Справочники Цикл
            Список.Добавить(МДОбъект.Имя, МДОбъект.Синоним);
        КонецЦикла;
    Иначе
        Для Каждого МДОбъект Из Метаданные.Документы Цикл
            Список.Добавить(МДОбъект.Имя, МДОбъект.Синоним);
        КонецЦикла;
    КонецЕсли;

    Список.СортироватьПоПредставлению();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТЧ()

    Список = Элементы.Импорт_ИмяТабличнойЧастиДокумента.СписокВыбора;
    Список.Очистить();

    МД = ОбъектМетаданных();
    Если МД = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Для Каждого МДТЧ Из МД.ТабличныеЧасти Цикл
        Список.Добавить(МДТЧ.Имя, МДТЧ.Синоним);
    КонецЦикла;

    // Единственная табличная часть выбирается сама
    Если Список.Количество() = 1 Тогда
        Объект.Импорт_ИмяТабличнойЧастиДокумента = Список[0].Значение;
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКлючейШапки()

    Список = Элементы.Импорт_КлючевоеПолеШапки.СписокВыбора;
    Список.Очистить();

    МД = ОбъектМетаданных();
    Если МД = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Для Каждого Заголовок Из СтандартныеКолонкиШапки() Цикл
        Список.Добавить(Заголовок, Заголовок);
    КонецЦикла;

    Для Каждого Реквизит Из МД.Реквизиты Цикл
        Список.Добавить(Реквизит.Имя, Реквизит.Синоним);
    КонецЦикла;

    Если ПустаяСтрока(Объект.Импорт_КлючевоеПолеШапки) Тогда
        Объект.Импорт_КлючевоеПолеШапки = ИмяКлючаПоУмолчанию();
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СтандартныеКолонкиШапки()

    Колонки = Новый Массив;
    Если ЭтаФорма.РежимИмпорта = "Справочник" Тогда
        Колонки.Добавить("Код");
        Колонки.Добавить("Наименование");
    Иначе
        Колонки.Добавить("Номер");
        Колонки.Добавить("Дата");
    КонецЕсли;
    Возврат Колонки;

КонецФункции

&НаСервере
Функция ИмяКлючаПоУмолчанию()
    Возврат ?(ЭтаФорма.РежимИмпорта = "Справочник", "Наименование", "Номер");
КонецФункции

&НаСервере
Функция ИмяАвтоКлюча()
    // Поле, значение которого платформа умеет присваивать сама
    Возврат ?(ЭтаФорма.РежимИмпорта = "Справочник", "Код", "Номер");
КонецФункции

&НаСервере
Функция ИмяКолонкиКлючаТЧ()
    Возврат Объект.Импорт_КлючевоеПолеТЧ;
КонецФункции

// ЗАГОЛОВКИ ТАБЛИЦ-ШАБЛОНОВ

&НаСервере
Процедура ЗаполнитьЗаголовкиШапки()

    Объект.Импорт_ТабличныйДокумент.Очистить();

    МД = ОбъектМетаданных();
    Если МД = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Колонки = СтандартныеКолонкиШапки();
    Для Каждого Реквизит Из МД.Реквизиты Цикл
        Колонки.Добавить(Реквизит.Имя);
    КонецЦикла;

    ВывестиЗаголовки(Объект.Импорт_ТабличныйДокумент, Колонки, Объект.Импорт_КлючевоеПолеШапки);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаголовкиТЧ()

    Объект.Импорт_ТабличныйДокументТЧ.Очистить();

    МД = ОбъектМетаданных();
    Если МД = Неопределено Или ПустаяСтрока(Объект.Импорт_ИмяТабличнойЧастиДокумента) Тогда
        Возврат;
    КонецЕсли;

    МДТЧ = МД.ТабличныеЧасти.Найти(Объект.Импорт_ИмяТабличнойЧастиДокумента);
    Если МДТЧ = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ЗаполнитьСписокКлючейТЧ();

    Колонки = Новый Массив;
    Для Каждого Реквизит Из МДТЧ.Реквизиты Цикл
        Колонки.Добавить(Реквизит.Имя);
    КонецЦикла;

    ВывестиЗаголовки(Объект.Импорт_ТабличныйДокументТЧ, Колонки, Объект.Импорт_КлючевоеПолеТЧ);

КонецПроцедуры

&НаСервере
Процедура ПодсветитьКлючи()

    // Перекрашиваем заголовки шапки, не трогая данные
    ТабДок = Объект.Импорт_ТабличныйДокумент;
    Для с = 1 По ТабДок.ШиринаТаблицы Цикл
        Область = ТабДок.Область("R1C" + Формат(с, "ЧГ="));
        Область.ЦветФона = ?(СокрЛП(Область.Текст) = Объект.Импорт_КлючевоеПолеШапки,
            Новый Цвет(255, 232, 160), Новый Цвет(225, 235, 250));
    КонецЦикла;

    // Если ключ ТЧ ещё не выбран — подбираем под новый ключ шапки
    Если Объект.Импорт_ЕстьТабличнаяЧасть И ПустаяСтрока(Объект.Импорт_КлючевоеПолеТЧ) Тогда
        ЗаполнитьСписокКлючейТЧ();
    КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиЗаголовки(ТабДок, Колонки, ИмяКлюча)

    Номер = 1;
    Для Каждого Имя Из Колонки Цикл
        Область = ТабДок.Область("R1C" + Формат(Номер, "ЧГ="));
        Область.Текст = Имя;
        Попытка
            Область.Шрифт = Новый Шрифт(, , , Истина);
            Область.ЦветФона = ?(Имя = ИмяКлюча,
                Новый Цвет(255, 232, 160), Новый Цвет(225, 235, 250));
            Область.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
            Область.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
            Область.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
            Область.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
        Исключение
        КонецПопытки;
        Попытка
            ТабДок.Область("C" + Формат(Номер, "ЧГ=")).ШиринаКолонки = Макс(14, СтрДлина(Имя) + 4);
        Исключение
        КонецПопытки;
        Номер = Номер + 1;
    КонецЦикла;

КонецПроцедуры

// КОМАНДЫ

&НаКлиенте
Процедура КомандаОчистить(Команда)

    Если Объект.Импорт_ТабличныйДокумент.ВысотаТаблицы > 1
        Или Объект.Импорт_ТабличныйДокументТЧ.ВысотаТаблицы > 1 Тогда
        ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьПослеВопроса", ЭтотОбъект),
            "Удалить все вставленные данные? Заголовки колонок будут восстановлены.",
            РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Очистка");
    Иначе
        ОчиститьПослеВопроса(КодВозвратаДиалога.Да, Неопределено);
    КонецЕсли;

КонецПроцедуры

// Вся очистка — одним серверным вызовом: данные удаляются, заголовки рисуются заново
&НаСервере
Процедура ОчиститьДанныеНаСервере()

    Объект.Импорт_ТабличныйДокумент.Очистить();
    Объект.Импорт_ТабличныйДокументТЧ.Очистить();

    ЗаполнитьЗаголовкиШапки();
    Если Объект.Импорт_ЕстьТабличнаяЧасть Тогда
        ЗаполнитьЗаголовкиТЧ();
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузить(Команда)

    ОчиститьСообщения();

    Если ПустаяСтрока(Объект.Импорт_ТипОбъектаДокумента) Тогда
        ПоказатьОшибку(?(ЭтаФорма.РежимИмпорта = "Справочник",
            "Выберите справочник, в который нужно загрузить данные.",
            "Выберите документ, который нужно загрузить."),
            "Объект.Импорт_ТипОбъектаДокумента");
        Возврат;
    КонецЕсли;

    Если Объект.Импорт_ЕстьТабличнаяЧасть И ПустаяСтрока(Объект.Импорт_ИмяТабличнойЧастиДокумента) Тогда
        ПоказатьОшибку("Выберите табличную часть, в которую загружать строки "
            + "(или снимите флажок «Есть табличная часть»).",
            "Объект.Импорт_ИмяТабличнойЧастиДокумента");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Объект.Импорт_ПерваяСтрокаДанных) Или Объект.Импорт_ПерваяСтрокаДанных < 2 Тогда
        Объект.Импорт_ПерваяСтрокаДанных = 2;
    КонецЕсли;

    Если Объект.Импорт_ЕстьТабличнаяЧасть И ПустаяСтрока(Объект.Импорт_КлючевоеПолеТЧ) Тогда
        ПоказатьОшибку("Выберите «Ключ ТЧ» — поле табличной части, по которому её строки связываются "
            + "с шапкой (например, «Номер заказа»).", "Объект.Импорт_КлючевоеПолеТЧ");
        Возврат;
    КонецЕсли;

    Если Объект.Импорт_ТабличныйДокумент.ВысотаТаблицы < 2 Тогда
        ПоказатьОшибку("В таблице нет данных. Вставьте строки из Excel, начиная со 2-й строки "
            + "(в 1-й строке находятся заголовки колонок).");
        Возврат;
    КонецЕсли;

    Если Объект.Импорт_ПерваяСтрокаДанных > Объект.Импорт_ТабличныйДокумент.ВысотаТаблицы Тогда
        ПоказатьОшибку("Первая строка данных (" + Объект.Импорт_ПерваяСтрокаДанных
            + ") больше, чем число строк в таблице (" + Объект.Импорт_ТабличныйДокумент.ВысотаТаблицы
            + "). Уменьшите значение или добавьте данные.", "Объект.Импорт_ПерваяСтрокаДанных");
        Возврат;
    КонецЕсли;

    Если Объект.Импорт_ЕстьТабличнаяЧасть Тогда
        Заполнено = ПроставитьКлючиТЧ();
        Если Заполнено > 0 Тогда
            ПоказатьОповещениеПользователя("Ключи проставлены", ,
                "В таблице табличной части заполнено ключей: " + Заполнено);
        КонецЕсли;
    КонецЕсли;

    Попытка
        Проверка = ПроверитьДанныеНаСервере();
    Исключение
        ПоказатьПредупреждение(, "Не удалось проверить данные: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат;
    КонецПопытки;

    Если Проверка.Ошибки.Количество() > 0 Тогда
        ПоказатьПредупреждение(, "Загрузка невозможна:" + Символы.ПС + Символы.ПС
            + СтрСоединить(Проверка.Ошибки, Символы.ПС));
        Возврат;
    КонецЕсли;

    ЭтоСправочник = (ЭтаФорма.РежимИмпорта = "Справочник");

    Текст = "Загрузка: " + Объект.Импорт_ТипОбъектаДокумента + Символы.ПС + Символы.ПС;
    Текст = Текст + "Строк " + ?(ЭтоСправочник, "справочника", "шапки") + ": " + Проверка.СтрокШапки + Символы.ПС;
    Текст = Текст + "  будет создано новых: " + Проверка.Создать + Символы.ПС;
    Текст = Текст + "  будет обновлено существующих: " + Проверка.Обновить + Символы.ПС;
    Если Проверка.Пропустить > 0 Тогда
        Текст = Текст + "  будет пропущено: " + Проверка.Пропустить + Символы.ПС;
    КонецЕсли;
    Если Проверка.Объединено > 0 Тогда
        Текст = Текст + "  повторяющихся строк шапки объединено (один ключ — один объект): "
            + Проверка.Объединено + Символы.ПС;
    КонецЕсли;
    Если Объект.Импорт_ЕстьТабличнаяЧасть Тогда
        Текст = Текст + "Строк табличной части: " + Проверка.СтрокТЧ + Символы.ПС;
    КонецЕсли;
    Если Не ЭтоСправочник И Объект.Импорт_ПроводитьДокументы Тогда
        Текст = Текст + Символы.ПС + "Документы будут ПРОВЕДЕНЫ." + Символы.ПС;
    КонецЕсли;
    Если Проверка.Обновить > 0 Тогда
        Текст = Текст + Символы.ПС + "Внимание: существующие объекты будут перезаписаны."
            + ?(Объект.Импорт_ЕстьТабличнаяЧасть, " Их табличные части заполнятся заново.", "") + Символы.ПС;
    КонецЕсли;
    Если Проверка.Предупреждения.Количество() > 0 Тогда
        Текст = Текст + Символы.ПС + "Обратите внимание:" + Символы.ПС
            + СтрСоединить(Проверка.Предупреждения, Символы.ПС) + Символы.ПС;
    КонецЕсли;
    Текст = Текст + Символы.ПС + "Продолжить?";

    ПоказатьВопрос(Новый ОписаниеОповещения("ЗагрузитьПослеВопроса", ЭтотОбъект), Текст,
        РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Подтверждение загрузки");

КонецПроцедуры

// ЗАГРУЗКА

&НаСервере
Функция ЗагрузитьДанныеНаСервере()

    Итог = Новый Структура("Создано, Обновлено, Ошибок", 0, 0, 0);

    МД = ОбъектМетаданных();
    Если МД = Неопределено Тогда
        Сообщить("Не найден объект метаданных «" + Объект.Импорт_ТипОбъектаДокумента + "»",
            СтатусСообщения.Важное);
        Возврат Итог;
    КонецЕсли;

    ЭтоСправочник = (ЭтаФорма.РежимИмпорта = "Справочник");
    ЕстьТЧ = Объект.Импорт_ЕстьТабличнаяЧасть;

    ИмяКлюча = ?(ПустаяСтрока(Объект.Импорт_КлючевоеПолеШапки),
        ИмяКлючаПоУмолчанию(), Объект.Импорт_КлючевоеПолеШапки);
    АвтоКлюч = (ИмяКлюча = ИмяАвтоКлюча());

    МДТЧ = Неопределено;
    Если ЕстьТЧ Тогда
        МДТЧ = МД.ТабличныеЧасти.Найти(Объект.Импорт_ИмяТабличнойЧастиДокумента);
        Если МДТЧ = Неопределено Тогда
            Сообщить("Не найдена табличная часть «" + Объект.Импорт_ИмяТабличнойЧастиДокумента + "»",
                СтатусСообщения.Важное);
            Возврат Итог;
        КонецЕсли;
    КонецЕсли;

    // === 1. Заголовки ===
    ЗаголовкиШапки = ЗаголовкиШапкиТаблицы(МД);
    Если ЗаголовкиШапки.Количество() = 0 Тогда
        Сообщить("Не найдены заголовки в первой строке таблицы", СтатусСообщения.Важное);
        Возврат Итог;
    КонецЕсли;

    Если ЗаголовкиШапки.Получить(ИмяКлюча) = Неопределено И Не АвтоКлюч Тогда
        Сообщить("В таблице нет колонки ключа «" + ИмяКлюча + "»", СтатусСообщения.Важное);
        Возврат Итог;
    КонецЕсли;

    ПроверитьКолонки(ЗаголовкиШапки, МД, СтандартныеКолонкиШапки(), "шапки");

    ЗаголовкиТЧ = Новый Соответствие;
    Если ЕстьТЧ Тогда
        ЗаголовкиТЧ = ЗаголовкиТаблицыТЧ(МДТЧ);
        Исключения = Новый Массив;
        Исключения.Добавить(ИмяКолонкиКлючаТЧ());
        ПроверитьКолонки(ЗаголовкиТЧ, МДТЧ, Исключения, "табличной части");
    КонецЕсли;

    // === 2. Читаем данные ===
    НачалоСтрок = Макс(2, Объект.Импорт_ПерваяСтрокаДанных);
    СтрокиШапки = ПрочитатьСтроки(Объект.Импорт_ТабличныйДокумент, ЗаголовкиШапки, НачалоСтрок);

    // Одинаковый ключ = один объект (повторы объединяются)
    Объединение = ОбъединитьСтрокиШапки(СтрокиШапки, ИмяКлюча);
    СтрокиШапки = Объединение.Строки;

    СтрокиТЧ = Новый Массив;
    Если ЕстьТЧ Тогда
        СтрокиТЧ = ПрочитатьСтроки(Объект.Импорт_ТабличныйДокументТЧ, ЗаголовкиТЧ, 2);
    КонецЕсли;

    // === 3. Привязка строк ТЧ к ключам (автоматически) ===
    ИндексТЧ = Новый Соответствие;
    СтрокиБезКлюча = Новый Массив;
    ПредыдущийКлюч = "";
    ИмяКолонкиКлюча = ИмяКолонкиКлючаТЧ();

    Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл

        ТекстКлюча = СтрокаТЧ.Получить(ИмяКолонкиКлюча);
        Если ТекстКлюча = Неопределено Тогда
            ТекстКлюча = "";
        КонецЕсли;

        Если ПустаяСтрока(ТекстКлюча) Тогда
            // Пустой ключ — продолжение предыдущего документа / элемента
            ТекстКлюча = ПредыдущийКлюч;
        Иначе
            ПредыдущийКлюч = ТекстКлюча;
        КонецЕсли;

        Если ПустаяСтрока(ТекстКлюча) Тогда
            СтрокиБезКлюча.Добавить(СтрокаТЧ);
            Продолжить;
        КонецЕсли;

        СопоставимыйКлюч = КлючДляСопоставления(ТекстКлюча);
        Если ИндексТЧ[СопоставимыйКлюч] = Неопределено Тогда
            ИндексТЧ.Вставить(СопоставимыйКлюч, Новый Массив);
        КонецЕсли;
        ИндексТЧ[СопоставимыйКлюч].Добавить(СтрокаТЧ);

    КонецЦикла;

    // Если загружается ровно один документ — ему достаются все строки ТЧ
    ОдинОбъект = (СтрокиШапки.Количество() = 1);

    Сообщить("Начало загрузки: " + МД.Синоним);
    Сообщить("Объектов к загрузке: " + СтрокиШапки.Количество());
    Если Объединение.Объединено > 0 Тогда
        Сообщить("Повторяющихся строк с тем же ключом объединено: " + Объединение.Объединено);
    КонецЕсли;
    Если ЕстьТЧ Тогда
        Сообщить("Строк в табличной части: " + СтрокиТЧ.Количество());
    КонецЕсли;
    Сообщить("----------------------------------------");

    // === 4. Основной цикл ===
    Для Каждого СтрокаШапки Из СтрокиШапки Цикл

        ТекстКлюча = СтрокаШапки.Получить(ИмяКлюча);
        Если ТекстКлюча = Неопределено Тогда
            ТекстКлюча = "";
        КонецЕсли;

        Если ПустаяСтрока(ТекстКлюча) И Не АвтоКлюч Тогда
            Сообщить("Пропущена строка: не заполнен ключ «" + ИмяКлюча + "»");
            Продолжить;
        КонецЕсли;

        // Поиск существующего
        ОбъектДанных = Неопределено;
        ЭтоНовый = Ложь;

        Если Не ПустаяСтрока(ТекстКлюча) Тогда
            Попытка
                Ссылка = НайтиСсылкуПоКлючу(МД, ЭтоСправочник, ИмяКлюча, ТекстКлюча);
            Исключение
                Сообщить("Ошибка поиска по ключу «" + ТекстКлюча + "»: " + ОписаниеОшибки(),
                    СтатусСообщения.Важное);
                Итог.Ошибок = Итог.Ошибок + 1;
                Продолжить;
            КонецПопытки;
        Иначе
            Ссылка = Неопределено;
        КонецЕсли;

        Если Ссылка <> Неопределено Тогда
            ОбъектДанных = Ссылка.ПолучитьОбъект();
        Иначе
            Если Объект.Импорт_НеСоздаватьНовыеДокументы Тогда
                Сообщить("«" + ТекстКлюча + "» не найден — пропущен");
                Продолжить;
            КонецЕсли;
            Если ЭтоСправочник Тогда
                ОбъектДанных = Справочники[МД.Имя].СоздатьЭлемент();
            Иначе
                ОбъектДанных = Документы[МД.Имя].СоздатьДокумент();
            КонецЕсли;
            ЭтоНовый = Истина;
        КонецЕсли;

        // Шапка
        Для Каждого КлючИЗначение Из СтрокаШапки Цикл

            ИмяРекв = КлючИЗначение.Ключ;
            Текст = КлючИЗначение.Значение;
            Если ПустаяСтрока(Текст) Тогда
                Продолжить;
            КонецЕсли;

            Попытка
                Если ЭтоСправочник И ИмяРекв = "Код" Тогда
                    ОбъектДанных.Код = ПривестиКодИлиНомер(Текст, МД, Истина);
                ИначеЕсли ЭтоСправочник И ИмяРекв = "Наименование" Тогда
                    ОбъектДанных.Наименование = Текст;
                ИначеЕсли Не ЭтоСправочник И ИмяРекв = "Номер" Тогда
                    ОбъектДанных.Номер = ПривестиКодИлиНомер(Текст, МД, Ложь);
                ИначеЕсли Не ЭтоСправочник И ИмяРекв = "Дата" Тогда
                    ОбъектДанных.Дата = ПреобразоватьДату(Текст);
                Иначе
                    РеквизитМД = МД.Реквизиты.Найти(ИмяРекв);
                    Если РеквизитМД <> Неопределено Тогда
                        ОбъектДанных[ИмяРекв] = ПреобразоватьЗначение(Текст, РеквизитМД.Тип);
                    КонецЕсли;
                КонецЕсли;
            Исключение
                Сообщить("Ошибка поля «" + ИмяРекв + "»: " + ОписаниеОшибки(),
                    СтатусСообщения.Важное);
            КонецПопытки;

        КонецЦикла;

        // Автоматический код / номер / дата для новых
        Если ЭтоНовый Тогда
            Попытка
                Если ЭтоСправочник Тогда
                    Если Не ЗначениеЗаполнено(ОбъектДанных.Код) Тогда
                        ОбъектДанных.УстановитьНовыйКод();
                    КонецЕсли;
                Иначе
                    Если Не ЗначениеЗаполнено(ОбъектДанных.Дата) Тогда
                        ОбъектДанных.Дата = ТекущаяДата();
                    КонецЕсли;
                    Если Не ЗначениеЗаполнено(ОбъектДанных.Номер) Тогда
                        ОбъектДанных.УстановитьНовыйНомер();
                    КонецЕсли;
                КонецЕсли;
            Исключение
                Сообщить("Не удалось присвоить код/номер автоматически: " + ОписаниеОшибки(),
                    СтатусСообщения.Важное);
            КонецПопытки;
        КонецЕсли;

        // Табличная часть
        Если ЕстьТЧ Тогда

            СтрокиГруппы = Неопределено;
            Если Не ПустаяСтрока(ТекстКлюча) Тогда
                СтрокиГруппы = ИндексТЧ[КлючДляСопоставления(ТекстКлюча)];
            КонецЕсли;

            // Один документ, а ключей в ТЧ нет — берём все строки
            Если СтрокиГруппы = Неопределено И ОдинОбъект И ИндексТЧ.Количество() = 0 Тогда
                СтрокиГруппы = СтрокиТЧ;
            КонецЕсли;

            Если СтрокиГруппы <> Неопределено Тогда

                ТЧ = ОбъектДанных[МДТЧ.Имя];
                ТЧ.Очистить();

                Для Каждого СтрокаТЧ Из СтрокиГруппы Цикл

                    НоваяСтрока = ТЧ.Добавить();

                    Для Каждого КлючИЗначение Из СтрокаТЧ Цикл
                        ИмяРекв = КлючИЗначение.Ключ;
                        Текст = КлючИЗначение.Значение;
                        Если ПустаяСтрока(Текст) Тогда
                            Продолжить;
                        КонецЕсли;

                        Попытка
                            РеквизитТЧ = МДТЧ.Реквизиты.Найти(ИмяРекв);
                            Если РеквизитТЧ <> Неопределено Тогда
                                НоваяСтрока[ИмяРекв] = ПреобразоватьЗначение(Текст, РеквизитТЧ.Тип);
                            КонецЕсли;
                        Исключение
                            Сообщить("Ошибка ТЧ «" + ИмяРекв + "»: " + ОписаниеОшибки(),
                                СтатусСообщения.Важное);
                        КонецПопытки;
                    КонецЦикла;
                КонецЦикла;

            КонецЕсли;
        КонецЕсли;

        // Запись
        Попытка
            Если ЭтоСправочник Тогда
                ОбъектДанных.Записать();
            Иначе
                РежимЗаписи = ?(Объект.Импорт_ПроводитьДокументы,
                    РежимЗаписиДокумента.Проведение,
                    РежимЗаписиДокумента.Запись);
                ОбъектДанных.Записать(РежимЗаписи);
            КонецЕсли;

            Если ЭтоНовый Тогда
                Итог.Создано = Итог.Создано + 1;
                Сообщить("Создан: " + ОбъектДанных.Ссылка);
            Иначе
                Итог.Обновлено = Итог.Обновлено + 1;
                Сообщить("Обновлён: " + ОбъектДанных.Ссылка);
            КонецЕсли;
        Исключение
            Сообщить("Ошибка записи: " + ОписаниеОшибки(), СтатусСообщения.Важное);
            Итог.Ошибок = Итог.Ошибок + 1;
        КонецПопытки;

    КонецЦикла;

    Если СтрокиБезКлюча.Количество() > 0 И Не ОдинОбъект Тогда
        Сообщить("Строк табличной части без ключа (пропущено): " + СтрокиБезКлюча.Количество(),
            СтатусСообщения.Важное);
    КонецЕсли;

    Сообщить("----------------------------------------");
    Сообщить("Создано: " + Итог.Создано);
    Сообщить("Обновлено: " + Итог.Обновлено);
    Сообщить("Ошибок: " + Итог.Ошибок);

    Возврат Итог;

КонецФункции

// ЧТЕНИЕ ТАБЛИЦ

&НаСервереБезКонтекста
Функция ПрочитатьЗаголовки(ТабДок, Словарь = Неопределено, Режим = "")

    Заголовки = Новый Соответствие;
    Для с = 1 По ТабДок.ШиринаТаблицы Цикл

        Имя = СокрЛП(ТабДок.Область("R1C" + Формат(с, "ЧГ=")).Текст);
        Если ПустаяСтрока(Имя) Тогда
            Продолжить;
        КонецЕсли;

        Если Словарь <> Неопределено Тогда
            Норм = НормализоватьЗаголовок(Имя);
            Каноническое = Словарь.Получить(Норм);
            Если Каноническое = Неопределено Тогда
                Каноническое = ПсевдонимСтандартнойКолонки(Норм, Режим);
            КонецЕсли;
            Если Каноническое <> Неопределено И Заголовки.Получить(Каноническое) = Неопределено Тогда
                Имя = Каноническое;
            КонецЕсли;
        КонецЕсли;

        Заголовки.Вставить(Имя, с);

    КонецЦикла;
    Возврат Заголовки;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьСтроки(ТабДок, Заголовки, НачальнаяСтрока)

    Строки = Новый Массив;
    Для К = НачальнаяСтрока По ТабДок.ВысотаТаблицы Цикл

        Если СтрокаТабличногоДокументаПустая(ТабДок, К) Тогда
            Продолжить;
        КонецЕсли;

        Данные = Новый Соответствие;
        Для Каждого КлючИЗначение Из Заголовки Цикл
            Данные.Вставить(КлючИЗначение.Ключ, СокрЛП(ТабДок.Область(
                "R" + Формат(К, "ЧГ=") + "C" + Формат(КлючИЗначение.Значение, "ЧГ=")).Текст));
        КонецЦикла;
        Строки.Добавить(Данные);

    КонецЦикла;
    Возврат Строки;

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьКолонки(Заголовки, МДОбъект, Стандартные, Описание)

    Для Каждого КлючИЗначение Из Заголовки Цикл
        Имя = КлючИЗначение.Ключ;
        Если Стандартные.Найти(Имя) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если МДОбъект.Реквизиты.Найти(Имя) = Неопределено Тогда
            Сообщить("Колонка «" + Имя + "» (" + Описание + ") не найдена среди реквизитов — будет пропущена",
                СтатусСообщения.Важное);
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СтрокаТабличногоДокументаПустая(ТабДок, НомерСтроки)

    Для с = 1 По ТабДок.ШиринаТаблицы Цикл
        Если Не ПустаяСтрока(ТабДок.Область(
            "R" + Формат(НомерСтроки, "ЧГ=") + "C" + Формат(с, "ЧГ=")).Текст) Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;

КонецФункции

// ПОИСК И КЛЮЧИ

// Ключи «10» и «000000010» считаются одинаковыми — поэтому после 9-й строки ничего вручную дописывать не нужно
&НаСервереБезКонтекста
Функция КлючДляСопоставления(Знач Текст)

    Текст = СокрЛП(Текст);
    Если ТолькоЦифры(Текст) Тогда
        Пока СтрДлина(Текст) > 1 И Лев(Текст, 1) = "0" Цикл
            Текст = Сред(Текст, 2);
        КонецЦикла;
    КонецЕсли;
    Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция ТолькоЦифры(Знач Текст)

    Если ПустаяСтрока(Текст) Тогда
        Возврат Ложь;
    КонецЕсли;
    Для н = 1 По СтрДлина(Текст) Цикл
        Если Найти("0123456789", Сред(Текст, н, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;

КонецФункции

// Приводит код / номер к формату объекта: «7» -> «000000007» для строковых кодов
&НаСервереБезКонтекста
Функция ПривестиКодИлиНомер(Знач Текст, МДОбъект, ЭтоКод)

    Текст = СокрЛП(Текст);

    Если ЭтоКод Тогда
        ЭтоСтрока = (МДОбъект.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Строка);
        Длина = МДОбъект.ДлинаКода;
    Иначе
        ЭтоСтрока = (МДОбъект.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Строка);
        Длина = МДОбъект.ДлинаНомера;
    КонецЕсли;

    Если Не ЭтоСтрока Тогда
        Возврат Число(Текст);
    КонецЕсли;

    Если ТолькоЦифры(Текст) И Длина > 0 И Длина <= 50 Тогда
        Пока СтрДлина(Текст) < Длина Цикл
            Текст = "0" + Текст;
        КонецЦикла;
    КонецЕсли;
    Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиСсылкуПоКлючу(МДОбъект, ЭтоСправочник, ИмяКлюча, Текст)

    // Варианты значения ключа (для Номера / Кода — как написано и с ведущими нулями)
    Варианты = Новый Массив;
    Если ЭтоСправочник И ИмяКлюча = "Код" Тогда
        Варианты.Добавить(ПривестиКодИлиНомер(Текст, МДОбъект, Истина));
        Если МДОбъект.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Строка Тогда
            Варианты.Добавить(Текст);
        КонецЕсли;
    ИначеЕсли Не ЭтоСправочник И ИмяКлюча = "Номер" Тогда
        Варианты.Добавить(ПривестиКодИлиНомер(Текст, МДОбъект, Ложь));
        Если МДОбъект.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Строка Тогда
            Варианты.Добавить(Текст);
        КонецЕсли;
    ИначеЕсли ИмяКлюча = "Наименование" Тогда
        Варианты.Добавить(Текст);
    ИначеЕсли ИмяКлюча = "Дата" Тогда
        Варианты.Добавить(ПреобразоватьДату(Текст));
    Иначе
        Варианты.Добавить(ПреобразоватьЗначение(Текст, МДОбъект.Реквизиты[ИмяКлюча].Тип));
    КонецЕсли;

    Для Каждого Вариант Из Варианты Цикл
        Запрос = Новый Запрос;
        Запрос.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + МДОбъект.ПолноеИмя() + " КАК Т
            |ГДЕ Т." + ИмяКлюча + " = &Знач";
        Запрос.УстановитьПараметр("Знач", Вариант);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Ссылка;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

// ПРЕОБРАЗОВАНИЕ ЗНАЧЕНИЙ

// Понимает: 27.02.2025, 27.02.25, 2/27/2025 и 27/2/2025 (из Excel), 2025-02-27, с временем «12:00:00 AM» / «14:30».
// День и месяц определяются по значениям: число больше 12 — это день. Если оба ≤ 12:
//   разделитель «.» — день.месяц.год;  разделитель «/» — месяц/день/год (как отдаёт Excel).
&НаСервереБезКонтекста
Функция ПреобразоватьДату(Знач СтрокаДаты)

    СтрокаДаты = СокрЛП(СтрокаДаты);
    Если ПустаяСтрока(СтрокаДаты) Тогда
        Возврат '00010101';
    КонецЕсли;

    Попытка
        ЧастиДатаВремя = СтрРазделить(СтрокаДаты, " ", Ложь);
        ТекстДаты = ЧастиДатаВремя[0];

        Разделитель = ".";
        Если Найти(ТекстДаты, "/") > 0 Тогда
            Разделитель = "/";
        ИначеЕсли Найти(ТекстДаты, "-") > 0 Тогда
            Разделитель = "-";
        КонецЕсли;

        Части = СтрРазделить(ТекстДаты, Разделитель, Ложь);

        Если Части.Количество() = 3 Тогда

            Первое = Число(Части[0]);
            Второе = Число(Части[1]);
            Третье = Число(Части[2]);

            Если СтрДлина(Части[0]) = 4 Тогда
                // ГГГГ-ММ-ДД
                Год = Первое;
                Месяц = Второе;
                День = Третье;
            Иначе
                Год = Третье;
                Если Первое > 12 Тогда
                    День = Первое;
                    Месяц = Второе;
                ИначеЕсли Второе > 12 Тогда
                    Месяц = Первое;
                    День = Второе;
                ИначеЕсли Разделитель = "/" Тогда
                    Месяц = Первое;
                    День = Второе;
                Иначе
                    День = Первое;
                    Месяц = Второе;
                КонецЕсли;
            КонецЕсли;

            Если Год < 100 Тогда
                Год = Год + 2000;
            КонецЕсли;

            Час = 0;
            Минута = 0;
            Секунда = 0;
            Если ЧастиДатаВремя.Количество() > 1 Тогда
                ЧастиВремени = СтрРазделить(ЧастиДатаВремя[1], ":", Ложь);
                Если ЧастиВремени.Количество() > 0 Тогда
                    Час = Число(ЧастиВремени[0]);
                КонецЕсли;
                Если ЧастиВремени.Количество() > 1 Тогда
                    Минута = Число(ЧастиВремени[1]);
                КонецЕсли;
                Если ЧастиВремени.Количество() > 2 Тогда
                    Секунда = Число(ЧастиВремени[2]);
                КонецЕсли;

                // AM / PM
                Если ЧастиДатаВремя.Количество() > 2 Тогда
                    Признак = ВРег(ЧастиДатаВремя[2]);
                    Если Признак = "PM" И Час < 12 Тогда
                        Час = Час + 12;
                    ИначеЕсли Признак = "AM" И Час = 12 Тогда
                        Час = 0;
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;

            Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Попытка
        Возврат Дата(СтрокаДаты);
    Исключение
        Сообщить("Не удалось распознать дату «" + СтрокаДаты + "». Допустимы форматы: 27.02.2025, 27.02.25, 2/27/2025, 2025-02-27.",
            СтатусСообщения.Важное);
        Возврат '00010101';
    КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьЗначение(Представление, ОписаниеТипов)

    Типы = ОписаниеТипов.Типы();
    Если Типы.Количество() <> 1 Тогда
        // Составной тип — оставляем как строку
        Возврат Представление;
    КонецЕсли;

    ТипЗначения = Типы[0];

    Если ТипЗначения = Тип("Число") Тогда
        Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Представление, Символы.НПП, ""), " ", ""), ",", ".");
        Попытка
            Возврат Число(Текст);
        Исключение
            Возврат 0;
        КонецПопытки;

    ИначеЕсли ТипЗначения = Тип("Дата") Тогда
        Возврат ПреобразоватьДату(Представление);

    ИначеЕсли ТипЗначения = Тип("Булево") Тогда
        н = НРег(СокрЛП(Представление));
        Возврат (н = "да" Или н = "истина" Или н = "1"
            Или н = "+" Или н = "включено");

    ИначеЕсли ТипЗначения = Тип("Строка") Тогда
        Возврат Представление;

    ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
        // Перечисление
        МДПеречисления = Метаданные.НайтиПоТипу(ТипЗначения);
        Менеджер = Перечисления[МДПеречисления.Имя];
        Для Каждого ЗначениеПеречисления Из Менеджер Цикл
            Если Строка(ЗначениеПеречисления) = Представление Тогда
                Возврат ЗначениеПеречисления;
            КонецЕсли;
        КонецЦикла;
        Сообщить("Не найдено значение перечисления «" + Представление + "»", СтатусСообщения.Информация);
        Возврат Неопределено;

    Иначе
        // Ссылочный тип — ищем по наименованию / коду / номеру
        МДСсылки = Метаданные.НайтиПоТипу(ТипЗначения);
        Если МДСсылки = Неопределено Тогда
            Возврат Неопределено;
        КонецЕсли;

        Поля = Новый Массив;
        Если Документы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
            Поля.Добавить("Номер");
        Иначе
            Поля.Добавить("Наименование");
            Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
                Поля.Добавить("Код");
            КонецЕсли;
        КонецЕсли;

        Для Каждого ИскатьПо Из Поля Цикл

            Значение = Представление;
            Если ИскатьПо = "Код" Тогда
                Если МДСсылки.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Число Тогда
                    Попытка
                        Значение = Число(Представление);
                    Исключение
                        Продолжить;
                    КонецПопытки;
                Иначе
                    Значение = ПривестиКодИлиНомер(Представление, МДСсылки, Истина);
                КонецЕсли;
            КонецЕсли;

            Запрос = Новый Запрос;
            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ " + МДСсылки.ПолноеИмя()
                + " КАК Т ГДЕ Т." + ИскатьПо + " = &Знач";
            Запрос.УстановитьПараметр("Знач", Значение);

            Попытка
                Выборка = Запрос.Выполнить().Выбрать();
                Если Выборка.Следующий() Тогда
                    Возврат Выборка.Ссылка;
                КонецЕсли;
            Исключение
            КонецПопытки;

        КонецЦикла;

        Сообщить("Не найден элемент «" + Представление + "» в " + МДСсылки.Синоним,
            СтатусСообщения.Информация);
        Возврат Неопределено;
    КонецЕсли;

КонецФункции

// КАРТИНКИ

&НаСервере
Процедура ОбновитьСпискиКартинок()

    Попытка
        СписокКлюча = Элементы.КартинкиКлюч.СписокВыбора;
        СписокРеквизита = Элементы.КартинкиРеквизит.СписокВыбора;
    Исключение
        Возврат;
    КонецПопытки;

    СписокКлюча.Очистить();
    СписокРеквизита.Очистить();
    ЭтаФорма.КартинкиРеквизит = "";

    МД = ОбъектМетаданных();
    Если МД = Неопределено Или ЭтаФорма.РежимИмпорта <> "Справочник" Тогда
        Возврат;
    КонецЕсли;

    СписокКлюча.Добавить("Код", "Код");
    СписокКлюча.Добавить("Наименование", "Наименование");

    Для Каждого Реквизит Из МД.Реквизиты Цикл
        СписокКлюча.Добавить(Реквизит.Имя, Реквизит.Синоним);
        Если Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения"))
            Или Реквизит.Тип.СодержитТип(Тип("ДвоичныеДанные")) Тогда
            СписокРеквизита.Добавить(Реквизит.Имя, Реквизит.Синоним);
        КонецЕсли;
    КонецЦикла;

    Если ПустаяСтрока(ЭтаФорма.КартинкиКлюч) Тогда
        ЭтаФорма.КартинкиКлюч = "Код";
    КонецЕсли;

    // Реквизит выбирается сам: единственный подходящий или с «картин» / «фото» в имени
    Если СписокРеквизита.Количество() = 1 Тогда
        ЭтаФорма.КартинкиРеквизит = СписокРеквизита[0].Значение;
    Иначе
        Для Каждого Элемент Из СписокРеквизита Цикл
            Имя = НРег(Элемент.Значение);
            Если Найти(Имя, "картин") > 0 Или Найти(Имя, "фото") > 0 Или Найти(Имя, "изображ") > 0 Тогда
                ЭтаФорма.КартинкиРеквизит = Элемент.Значение;
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

КонецПроцедуры

